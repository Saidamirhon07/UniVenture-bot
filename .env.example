# Required: reuse the existing bot's production values.
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_token
OPENAI_API_KEY=sk-replace_me
SESSION_SECRET=replace_with_a_long_random_value
MINI_APP_URL=https://your-production-domain.up.railway.app

# One Railway volume mounted at /data keeps bot and Mini App data identical.
DATA_DIR=/data
PAID_DB_PATH=/data/paid_users.json
CHROMA_PATH=/data/chroma_store
CHROMA_COLLECTION_PREFIX=global
PRODUCT_ANALYTICS_PATH=/data/product_analytics.json
QUESTION_BANK_PATH=/data/generated_question_bank.json

OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_STRONG_MODEL=gpt-4.1
OPENAI_FALLBACK_MODEL=gpt-4o-mini
FREE_TRIAL_DAYS=0
DEFAULT_SUB_DAYS=30
PAYWALL_ENABLED=1
RUN_TELEGRAM_BOT=1
APP_ONLY_MODE=1

# Manual UZS transfer. Keep card details in Railway Variables, not GitHub.
PAYMENT_PRICE_UZS=199000
PAYMENT_CARD=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=YOUR NAME
PAYMENT_BANK=YOUR BANK
PAYMENT_NOTE=Send a clear screenshot showing the completed transfer.
SUPPORT_HANDLE=@UniVentureSupport_bot
ADMIN_IDS=886181760

# Security and optional operations.
TELEGRAM_AUTH_MAX_AGE_SECONDS=21600
SESSION_TTL_SECONDS=21600
MAX_UPLOAD_BYTES=5242880
FREE_PRACTICE_QUESTIONS_PER_DAY=3
FREE_COPILOT_MESSAGES_PER_DAY=3
FREE_ESSAY_EVALUATIONS=1
AI_MAX_CONCURRENCY=10
CORS_ORIGINS=
ENABLE_API_DOCS=0
DEV_AUTH_BYPASS=0
LOG_LEVEL=INFO
