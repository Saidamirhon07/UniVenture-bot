# Required: reuse the existing bot's production values.
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_token
OPENAI_API_KEY=sk-replace_me
SESSION_SECRET=replace_with_a_long_random_value
MINI_APP_URL=https://your-production-domain.up.railway.app

# One Railway volume mounted at /data keeps bot and Mini App data identical.
DATA_DIR=/data
PAID_DB_PATH=/data/paid_users.json
CHROMA_PATH=/data/chroma_store
CHROMA_COLLECTION_PREFIX=global

OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_STRONG_MODEL=gpt-4.1
FREE_TRIAL_DAYS=30
DEFAULT_SUB_DAYS=30
PAYWALL_ENABLED=1
RUN_TELEGRAM_BOT=1

# Payment settings already used by AIBOT.py.
PAYMENT_PRICE_USD=$29
PAYMENT_CARD=
PAYMENT_CLICK=
PAYMENT_PAYME=
PAYMENT_NOTE=
SUPPORT_HANDLE=@UniVentureSupport_bot

# Security and optional operations.
TELEGRAM_AUTH_MAX_AGE_SECONDS=21600
SESSION_TTL_SECONDS=21600
MAX_UPLOAD_BYTES=5242880
CORS_ORIGINS=
ENABLE_API_DOCS=0
DEV_AUTH_BYPASS=0
LOG_LEVEL=INFO

